# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development  # "development" | "production"

# ─── Database — Neon PostgreSQL ───────────────────────────────────────────────
# Get this from your Neon dashboard → Connection Details → Connection String
# Format: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/ishosFactory?sslmode=require
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/ishosFactory?sslmode=require

# ─── PocketBase (embedded auth engine) ────────────────────────────────────────
# Directory where PocketBase stores its SQLite data (auth collections, logs, etc.)
# PocketBase runs as an embedded Go library — no separate server required.
# Defaults to "./pb_data" if not set.
PB_DATA_DIR=./pb_data
ENABLE_PB_ADMIN_UI=false
PB_ADMIN_UI_HOST=127.0.0.1
PB_ADMIN_UI_PORT=8090
PB_ADMIN_UI_ALLOWED_ORIGINS=http://localhost:8090
ALLOW_PB_ADMIN_UI_IN_PRODUCTION=false

# ─── Supabase Storage (images only) ──────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
# Name of the Storage bucket you created for product images
SUPABASE_BUCKET=product-images

# ─── WhatsApp Business API (optional) ────────────────────────────────────────
# If these are empty, WhatsApp notifications are logged instead of sent.
# Get these from Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Your business phone number shown to customers (for display only)
WHATSAPP_NUMBER=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max orders a single IP can create per hour (public order endpoint)
ORDERS_PER_HOUR=5
# Max orders a single phone number can create per day
ORDERS_PER_DAY=20
# Max login attempts a single IP can do per minute
LOGIN_ATTEMPTS_PER_MINUTE=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Astro frontend.
# In development: http://localhost:4321 (Astro dev server)
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:4321
