# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
ENV=development  # "development" | "production"

# ─── Database — Neon PostgreSQL ───────────────────────────────────────────────
# Get this from your Neon dashboard → Connection Details → Connection String
# Prefer Neon DIRECT endpoint (no "-pooler" in host) for API servers using Ent.
# Pooler endpoints can cause intermittent prepared statement errors with some query patterns.
# Format: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/ishosFactory?sslmode=require
DATABASE_URL=postgres://user:password@ep-example.us-east-2.aws.neon.tech/ishosFactory?sslmode=require

# ─── PocketBase (embedded auth engine) ────────────────────────────────────────
# Directory where PocketBase stores its SQLite data (auth collections, logs, etc.)
# PocketBase runs as an embedded Go library — no separate server required.
# Defaults to "./pb_data" if not set.
PB_DATA_DIR=./pb_data
ENABLE_PB_ADMIN_UI=false
PB_ADMIN_UI_HOST=127.0.0.1
PB_ADMIN_UI_PORT=8090
PB_ADMIN_UI_ALLOWED_ORIGINS=http://localhost:8090
ALLOW_PB_ADMIN_UI_IN_PRODUCTION=false

# ─── Cloudflare R2 (images only) ─────────────────────────────────────────────
# Get these from Cloudflare R2 → bucket settings / API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=product-images
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# For development you can use the bucket's public development URL.
# For production prefer a custom domain mapped to the bucket.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Max uploaded image size in MB for /api/v1/upload/image.
ADMIN_IMAGE_UPLOAD_MAX_MB=15

# ─── WhatsApp Business API (optional) ────────────────────────────────────────
# If these are empty, WhatsApp notifications are logged instead of sent.
# Get these from Meta Developer Portal → WhatsApp → API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Your business phone number shown to customers (for display only)
WHATSAPP_NUMBER=
# Public storefront URL used in links shared with customers
PUBLIC_STORE_URL=http://localhost:4321

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max orders a single IP can create per hour (public order endpoint)
ORDERS_PER_HOUR=5
# Max orders a single phone number can create per day
ORDERS_PER_DAY=20
# Max login attempts a single IP can do per minute
LOGIN_ATTEMPTS_PER_MINUTE=10
# Lock account/IP for a period after too many failed logins in the window
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15
# Browser auth cookie TTL in hours (token revocation is checked server-side on protected routes)
AUTH_COOKIE_TTL_HOURS=24
# PocketBase employee auth JWT TTL in hours (default PocketBase is 7 days)
AUTH_TOKEN_TTL_HOURS=168
# Public order tracking endpoint throttle per IP/hour
TRACKING_REQUESTS_PER_HOUR=60
# Secret used to sign public tracking tokens. Set a dedicated strong value in production.
TRACKING_TOKEN_SECRET=
# Public order tracking token TTL in hours (default 30 days)
TRACKING_TOKEN_TTL_HOURS=720

# Redis (recommended in production for distributed rate limiting across instances)
# Example: redis://default:your-password@your-redis-host:6379/0
REDIS_URL=
# Namespaces limiter keys per app/environment
REDIS_PREFIX=ishos

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Astro frontend.
# In development: http://localhost:4321 (Astro dev server)
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:4321
