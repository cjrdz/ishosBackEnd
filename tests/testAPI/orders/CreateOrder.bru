meta {
  name: CreateOrder
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/orders
  body: json
  auth: inherit
}

body:json {
  {
    "customer_name": "Test Customer",
    "customer_phone": "+50688887777",
    "payment_method": "efectivo",
    "order_type": "takeaway",
    "notes": "Bruno order workflow",
    "items": [
      {
        "product_id": "{{productId}}",
        "quantity": 1,
        "customizations": {}
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
